{
  "name": "halal-be",
  "main": "src/worker.ts",
  "compatibility_date": "2025-09-01",
  // nodejs_compat: pg, node:crypto (scrypt), AsyncLocalStorage; process.env is filled from vars/secrets.
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "NODE_ENV": "production" },
  // Run the worker next to the database instead of next to the caller: every query is a round trip to Postgres.
  "placement": { "mode": "smart" },
  // Pooled connections to Neon (no TCP + TLS + auth handshake per request). Query caching is disabled on this config.
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "58f0582377e94862aa7197541e1abcbb" }],
  "observability": { "enabled": true }
}
